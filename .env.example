# PostgreSQL (docker-compose). Deux rôles distincts (ADR 0005) :
# - DATABASE_URL : l'application, rôle `expense_app` (NOSUPERUSER NOBYPASSRLS),
#   soumis aux policies RLS. Son mot de passe est posé par `make ensure-app-role`.
# - MIGRATION_DATABASE_URL : le propriétaire du schéma, pour les migrations et
#   le seed uniquement. L'application ne doit jamais l'utiliser.
DATABASE_URL=postgres://expense_app:expense_app@localhost:5433/expense_io
MIGRATION_DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io

# Auth.js — obligatoire : l'application refuse de démarrer sans secret, ou
# avec cette valeur d'exemple. `make env` la remplace par un secret aléatoire
# (sinon : `openssl rand -base64 32`).
AUTH_SECRET=changeme-generate-a-real-secret-for-non-local-use
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true
